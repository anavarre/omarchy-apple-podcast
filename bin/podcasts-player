#!/usr/bin/bash
# Audio playback for the Apple Podcasts plugin: a headless mpv, driven over its
# JSON IPC socket. Service.qml runs this as `/usr/bin/bash podcasts-player
# <command> [args]` with a scrubbed environment (Model.environment); it can also
# be run by hand.
#
#   play URL TITLE [START]
#                    stop whatever is playing and start URL (http or https),
#                    START whole seconds in (0 if omitted)
#   toggle           pause or resume
#   seek SECONDS     jump relative to now; negative goes back
#   seekto SECONDS   jump to an absolute position
#   speed RATE       playback speed: 0.8, 1, 1.3, 1.5, 1.8 or 2 (pitch is kept);
#                    remembered, so every later episode starts at it
#   getspeed         print the remembered speed (1 if none)
#   status           print {"position":N,"duration":N,"paused":B,"buffering":B,
#                    "speed":N,"title":"..."} while mpv is up
#   stop             quit mpv
#
# The URL is an episode's `assetUrl`: the publisher's own audio file, which
# Apple's catalogue lists and which needs no token, so nothing here ever sees
# the Apple credentials. mpv runs detached, so the audio carries on if the shell
# reloads; `status` finds it again through the socket.
#
# Exit codes: 24 no usable runtime directory, 30 mpv is not running, 31 mpv
# could not be started, 64 bad arguments.

set -u
PATH=/usr/bin:/bin; export PATH

usage() { printf 'podcasts-player: %s\n' "$1" >&2; exit 64; }

# The socket lives under the user's runtime directory (0700 and per-user), not
# /tmp, so another user can neither listen on it nor plant one.
run="${PODCASTS_PLAYER_DIR:-}"
if [ -z "$run" ]; then
  case "${XDG_RUNTIME_DIR:-}" in /*) run="$XDG_RUNTIME_DIR/omarchy-apple-podcasts" ;; esac
fi
[ -n "$run" ] || { printf 'No XDG_RUNTIME_DIR, so there is nowhere safe for the player socket.\n' >&2; exit 24; }
sock="$run/mpv.sock"

# The chosen speed outlives mpv and the session, so it lives in the config dir.
cfg="${XDG_CONFIG_HOME:-}"; case "$cfg" in /*) ;; *) cfg="$HOME/.config" ;; esac
speedfile="${PODCASTS_PLUGIN_DIR:-$cfg/omarchy/apple-podcasts}/speed"
saved_speed() {
  local v=1
  [ -f "$speedfile" ] && [ ! -L "$speedfile" ] && read -r v < "$speedfile"
  case "$v" in 0.8|1|1.3|1.5|1.8|2) printf '%s' "$v" ;; *) printf 1 ;; esac
}

prepare() {
  [ -L "$run" ] && { printf 'Refusing %s: it is a symlink.\n' "$run" >&2; exit 24; }
  mkdir -p "$run" && chmod 700 "$run" && [ -O "$run" ] || { printf 'Could not use %s.\n' "$run" >&2; exit 24; }
}

# Send commands to mpv, one JSON object per line on stdin; prints its replies.
# -t gives mpv a moment to answer before socat gives up on the quiet socket.
ipc() { socat -t 0.3 - "UNIX-CONNECT:$sock" 2> /dev/null; }
alive() { [ -S "$sock" ] && printf '{"command":["get_property","pid"]}\n' | ipc | grep -q '"error":"success"'; }

cmd_play() {
  local url="${1:-}" title="${2:-Podcast episode}" start="${3:-0}"
  case "$url" in http://*|https://*) ;; *) usage 'play: URL must be http:// or https://' ;; esac
  case "$url" in *[[:space:][:cntrl:]]*) usage 'play: URL has whitespace or control characters' ;; esac
  case "$start" in ''|*[!0-9]*) usage 'play: START must be whole seconds' ;; esac
  title=$(printf '%s' "$title" | tr -d '[:cntrl:]' | cut -c1-200)
  prepare
  alive && { printf '{"command":["quit"]}\n' | ipc > /dev/null; sleep 0.2; }
  rm -f "$sock"
  # --no-config and --ytdl=no: neither the user's mpv.conf nor a youtube-dl
  # hook gets to run on a URL that came from a remote catalogue. After `--`
  # everything is a file name, so a URL can never be read as an option.
  setsid -f mpv --no-config --no-video --ytdl=no --really-quiet --force-window=no \
    --idle=no --audio-display=no --input-ipc-server="$sock" --speed="$(saved_speed)" --start="$start" \
    --force-media-title="$title" ${PODCASTS_MPV_AO:+--ao="$PODCASTS_MPV_AO"} \
    -- "$url" > /dev/null 2>&1 < /dev/null
  local i
  for i in $(seq 40); do alive && return 0; sleep 0.1; done
  printf 'mpv did not start.\n' >&2; exit 31
}

cmd_toggle() {
  alive || exit 30
  printf '{"command":["cycle","pause"]}\n' | ipc > /dev/null
}

cmd_seek() {
  local n="${1:-}" mode="$2"
  case "$n" in ''|*[!0-9-]*|*?-*) usage 'seek: SECONDS must be an integer' ;; esac
  alive || exit 30
  printf '{"command":["seek",%s,"%s"]}\n' "$n" "$mode" | ipc > /dev/null
}

cmd_speed() {
  case "${1:-}" in 0.8|1|1.3|1.5|1.8|2) ;; *) usage 'speed: RATE must be one of 0.8 1 1.3 1.5 1.8 2' ;; esac
  local dir; dir=$(dirname "$speedfile")
  if [ ! -L "$dir" ] && mkdir -p "$dir" 2> /dev/null; then printf '%s\n' "$1" > "$speedfile" 2> /dev/null; fi
  alive || return 0
  printf '{"command":["set_property","speed",%s]}\n' "$1" | ipc > /dev/null
}

# Pulls the value of the reply that carries request_id $2 out of replies $1.
reply() { printf '%s\n' "$1" | sed -n "s/.*\"data\":\(.*\),\"request_id\":$2,\"error\":\"success\".*/\1/p" | head -n1; }

cmd_status() {
  alive || exit 30
  local out pos dur paused buf title speed
  out=$(printf '%s\n' \
    '{"command":["get_property","time-pos"],"request_id":1}' \
    '{"command":["get_property","duration"],"request_id":2}' \
    '{"command":["get_property","pause"],"request_id":3}' \
    '{"command":["get_property","paused-for-cache"],"request_id":4}' \
    '{"command":["get_property","media-title"],"request_id":5}' \
    '{"command":["get_property","speed"],"request_id":6}' | ipc) || exit 30
  pos=$(reply "$out" 1); dur=$(reply "$out" 2); paused=$(reply "$out" 3)
  buf=$(reply "$out" 4); title=$(reply "$out" 5); speed=$(reply "$out" 6)
  printf '{"position":%s,"duration":%s,"paused":%s,"buffering":%s,"speed":%s,"title":%s}\n' \
    "${pos:-0}" "${dur:-0}" "${paused:-false}" "${buf:-false}" "${speed:-1}" "${title:-\"\"}"
}

cmd_stop() {
  alive || return 0
  printf '{"command":["quit"]}\n' | ipc > /dev/null
}

[ $# -ge 1 ] || usage 'a command is required'
cmd=$1; shift
case "$cmd" in
  play) cmd_play "$@" ;;
  toggle) cmd_toggle ;;
  seek) cmd_seek "${1:-}" relative ;;
  seekto) cmd_seek "${1:-}" absolute ;;
  speed) cmd_speed "${1:-}" ;;
  getspeed) saved_speed; printf '\n' ;;
  status) cmd_status ;;
  stop) cmd_stop ;;
  *) usage "unknown command: $cmd" ;;
esac
